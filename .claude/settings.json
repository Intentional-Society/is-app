{
  "permissions": {
    "ask": [
      "Bash(gh pr merge *--admin*)",
      "Bash(gh pr merge *--auto*)",
      "Bash(gh pr merge *-R*)",
      "Bash(gh pr merge *--repo*)",
      "Bash(gh -* pr merge *)",
      "PowerShell(gh pr merge *--admin*)",
      "PowerShell(gh pr merge *--auto*)",
      "PowerShell(gh pr merge *-R*)",
      "PowerShell(gh pr merge *--repo*)",
      "PowerShell(gh -* pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr merge *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ship-merge-gate.mjs"],
            "onFailure": "block",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(*gh.exe* pr merge *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ship-merge-gate.mjs"],
            "onFailure": "block",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(gh pr merge *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ship-merge-gate.mjs"],
            "onFailure": "block",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "PowerShell(*gh.exe* pr merge *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ship-merge-gate.mjs"],
            "onFailure": "block",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
